{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/contact/",
      "permanent": false
    },
    {
      "source": "/pricing/:rest*",
      "destination": "/contact/",
      "permanent": false
    },
    {
      "source": "/:slug(lachontale[^n/]+a)",
      "destination": "/managuita/",
      "permanent": false
    },
    {
      "source": "/:slug(lachontale[^n/]+a)/:rest*",
      "destination": "/managuita/:rest*",
      "permanent": false
    },
    {
      "source": "/managu%C3%ADta",
      "destination": "/managuita/",
      "permanent": false
    },
    {
      "source": "/managüita",
      "destination": "/managuita/",
      "permanent": false
    },
    {
      "source": "/managu%C3%BCita",
      "destination": "/managuita/",
      "permanent": false
    },
    {
      "source": "/managu%C3%BCita/:rest*",
      "destination": "/managuita/:rest*",
      "permanent": false
    }
  ]
}
